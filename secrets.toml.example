# Example only. Generate real values with: python setup_secrets.py
# Put the result in Streamlit Cloud Secrets, or .streamlit/secrets.toml locally.
# Never commit the real secrets file. Preserve the same encryption key forever.

[app]
password_hash = "GENERATE_WITH_SETUP_SECRETS_PY"
session_minutes = 30

[github]
token = "PASTE_YOUR_GITHUB_TOKEN"
repo = "YOUR_USERNAME/YOUR_DATA_REPOSITORY"
branch = "main"
path = "data/epa_store.enc"

[security]
fernet_key = "GENERATE_WITH_SETUP_SECRETS_PY"
